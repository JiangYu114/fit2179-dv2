{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Global plastic production 1950–2022 with key event annotations. Source: PlasticsEurope, Our World in Data.",
  "width": "container",
  "height": 240,
  "data": {
    "values": [
      { "year": 1950, "prod": 2  },
      { "year": 1955, "prod": 3  },
      { "year": 1960, "prod": 8  },
      { "year": 1965, "prod": 15 },
      { "year": 1970, "prod": 26 },
      { "year": 1975, "prod": 40 },
      { "year": 1980, "prod": 46 },
      { "year": 1985, "prod": 60 },
      { "year": 1990, "prod": 99 },
      { "year": 1995, "prod": 130},
      { "year": 2000, "prod": 204},
      { "year": 2005, "prod": 234},
      { "year": 2009, "prod": 250},
      { "year": 2010, "prod": 270},
      { "year": 2015, "prod": 322},
      { "year": 2019, "prod": 368},
      { "year": 2022, "prod": 400}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "line": { "color": "#00bcd4", "strokeWidth": 2 },
        "color": {
          "expr": "{ gradient: 'linear', x1: 0, y1: 0, x2: 0, y2: 1, stops: [{offset:0, color:'rgba(0,188,212,0.25)'},{offset:1, color:'rgba(0,188,212,0.02)'}]}"
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "axis": { "format": "d", "title": null, "grid": false }
        },
        "y": {
          "field": "prod",
          "type": "quantitative",
          "axis": { "title": "Million tonnes" }
        }
      }
    },
    {
      "data": {
        "values": [
          { "year": 1965, "prod": 15,  "label": "Single-use plastics introduced" },
          { "year": 2015, "prod": 322, "label": "Paris Agreement" }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1a3a5c",
        "strokeDash": [4, 3],
        "strokeWidth": 1
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    },
    {
      "data": {
        "values": [
          { "year": 1965, "prod": 15,  "label": "Single-use\nplastics born" },
          { "year": 2015, "prod": 322, "label": "Paris Agreement" }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -10,
        "dx": 5,
        "fontSize": 9,
        "align": "left",
        "color": "#3a6688",
        "font": "DM Sans"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "prod", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
