{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 4 — Lollipop chart: Ocean plastic emissions in Southeast/South Asia (kt/yr). Malaysia highlighted in coral. Source: Meijer et al. 2021, via Our World in Data.",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      { "country": "Philippines", "emissions": 356.4, "highlight": false },
      { "country": "Malaysia",    "emissions":  73.9, "highlight": true  },
      { "country": "Indonesia",   "emissions":  56.4, "highlight": false },
      { "country": "Myanmar",     "emissions":  40.0, "highlight": false },
      { "country": "Vietnam",     "emissions":  28.2, "highlight": false },
      { "country": "Bangladesh",  "emissions":  24.6, "highlight": false },
      { "country": "Thailand",    "emissions":  18.5, "highlight": false },
      { "country": "Sri Lanka",   "emissions":  14.9, "highlight": false },
      { "country": "Cambodia",    "emissions":  10.2, "highlight": false },
      { "country": "Singapore",   "emissions":   1.2, "highlight": false }
    ]
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#0a2a40", "strokeWidth": 2 },
      "encoding": {
        "y":  { "field": "country",   "type": "nominal", "sort": "-x", "axis": { "title": null } },
        "x":  { "field": "emissions", "type": "quantitative", "axis": { "title": "Ocean plastic (thousand tonnes/yr)", "grid": true } },
        "x2": { "datum": 0 }
      }
    },
    {
      "mark": { "type": "circle", "size": 80 },
      "encoding": {
        "y": { "field": "country",   "type": "nominal", "sort": "-x" },
        "x": { "field": "emissions", "type": "quantitative" },
        "color": {
          "condition": { "test": "datum.highlight", "value": "#ff6b5b" },
          "value": "#00bcd4"
        },
        "tooltip": [
          { "field": "country",   "title": "Country"     },
          { "field": "emissions", "title": "kt/yr", "format": ".1f" }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.highlight" }],
      "mark": { "type": "text", "align": "left", "dx": 8, "fontSize": 10, "color": "#ff6b5b", "font": "DM Sans" },
      "encoding": {
        "y":    { "field": "country",   "type": "nominal", "sort": "-x" },
        "x":    { "field": "emissions", "type": "quantitative" },
        "text": { "value": "← Malaysia" }
      }
    }
  ]
}
