              ]
            }
          },
          "y": {
            "field": "proportion",
            "type": "quantitative",
            "axis": {
              "title": "% Clean basins",
              "grid": true
            },
            "scale": {
              "domain": [
                0,
                85
              ]
            }
          },
          "color": {
            "value": "#00bcd4"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "strokeWidth": 2,
          "color": "#00bcd4"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "proportion",
