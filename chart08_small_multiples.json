    {
      "filter": "datum.status === 'Clean'"
    },
    {
      "calculate": "datum.indicator === 'BOD₅' ? 'BOD₅ — Organic Waste' : datum.indicator === 'NH₃-N' ? 'NH₃-N — Ammonia' : 'SS — Suspended Solids'",
      "as": "indicator_label"
    }
  ],
  "facet": {
    "field": "indicator_label",
    "type": "nominal",
    "columns": 3,
    "header": {
      "titleFontSize": 0,
      "labelFontSize": 11,
      "labelColor": "#7aafc8",
      "labelFont": "DM Sans"
    }
  },
  "spec": {
    "width": 280,
    "height": 180,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "line": {
            "strokeWidth": 2
          },
          "color": {
            "expr": "{ gradient: 'linear', x1:0, y1:0, x2:0, y2:1, stops: [{offset:0, color:'rgba(0,188,212,0.3)'},{offset:1,color:'rgba(0,188,212,0.02)'}]}"
          }
        },
